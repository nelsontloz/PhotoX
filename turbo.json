{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "100%",
  "globalPassThroughEnv": [
    "DEBUG",
    "AUTH_TOKEN_SECRET",
    "AUTH_ACCESS_TTL",
    "AUTH_REFRESH_TTL",
    "AUTH_CLOCK_TOLERANCE_SEC",
    "TESTCONTAINERS_RYUK_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
