{
  "name": "@photox/worker-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "face-model": "bash scripts/download-face-model.sh",
    "vision-model": "bash scripts/download-vision-model.sh",
    "detect-model": "bash scripts/download-detect-model.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@photox/shared-config": "workspace:*",
    "@photox/shared-types": "workspace:*",
    "bullmq": "^6.4.0",
    "exifreader": "^4.51.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^6.0.0",
    "onnxruntime-node": "^1.30.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^24.19.2",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
