{
  "name": "@photox/worker-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "face-model": "bash scripts/download-face-model.sh",
    "vision-model": "bash scripts/download-vision-model.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@photox/shared-config": "workspace:*",
    "@photox/shared-types": "workspace:*",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "bullmq": "^5.81.3",
    "exifreader": "^4.46.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^5.0.0",
    "onnxruntime-node": "^1.30.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/node": "^22.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.7"
  }
