{
  "name": "photox",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @photox/e2e test:e2e",
    "verify": "pnpm run lint && turbo run test --force && pnpm run typecheck && pnpm run build && E2E_BUILD=1 pnpm run test:e2e",
    "postinstall": "test \"${FACE_MODEL_SKIP:-}\" = 1 || bash scripts/download-models.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.22.4",
    "turbo": "^2.3.0"
  }
}
