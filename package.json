{
  "name": "photox",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @photox/e2e test:e2e",
    "verify": "pnpm run lint && turbo run test --force && pnpm run typecheck && pnpm run build && E2E_BUILD=1 pnpm run test:e2e",
    "postinstall": "test \"${FACE_MODEL_SKIP:-}\" = 1 || for s in face vision detect; do bash apps/worker-service/scripts/download-$s-model.sh; done"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.0"
  }
}
