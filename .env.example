NODE_ENV=development

# API
API_PORT=3000

# Worker
WORKER_SERVICE_PORT=3004
CORE_URL=http://localhost:3000
# Face detection runs on InsightFace SCRFD-10G (det_10g.onnx).
# SCRFD weights live under STORAGE_DIR/models (pnpm --filter @photox/worker-service face-model)
# Optional: override the SCRFD detector model file (default <STORAGE_DIR>/models/det_10g.onnx)
# FACE_DETECTOR_MODEL_PATH=/path/to/det_10g.onnx

# Web App (same-origin /api in dev)
VITE_API_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=photox
POSTGRES_PASSWORD=photox_dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=photox_dev

# Auth — every secret needs 32+ chars AND entropy (16+ unique chars, no 6-char run).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TOKEN_SECRET=change-me-to-at-least-32-characters-long-string
# Optional: previous secret kept only during rotation (verify fallback, never signs)
# AUTH_TOKEN_SECRET_PREVIOUS=
# Worker delegation secret: the worker signs ONLY with this; core verifies user-secret
# tokens first, then previous, then this (worker-origin tokens still need act + allowlist)
WORKER_JWT_SECRET=change-me-to-a-different-32-characters-long-string
AUTH_ACCESS_TTL=30m
AUTH_REFRESH_TTL=1d
AUTH_CLOCK_TOLERANCE_SEC=60
# Optional: hourly registration attempts per IP (default 10)
# RATE_LIMIT_REGISTER=10
# Optional: seed an admin user on core bootstrap when no admin exists (open registration
# only mints role 'user'). Leave both empty to disable.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Local file storage (default for local dev)
STORAGE_DIR=./data/storage
# Optional: per-user storage quota in bytes for original uploads (unlimited when unset).
# Checked after the dedup fast-path, so re-uploading owned bytes never counts; over-quota
# uploads are rejected with 413 before any bytes are written. Example: 10 GiB.
# STORAGE_QUOTA_BYTES=10737418240

# S3-compatible backup storage (Floci, dev-only local S3 at http://localhost:4566 on host)
S3_BACKUP_BUCKET=photox-dev-backups
# Object prefix for per-user backups (default backups/ when unset)
# S3_BACKUP_PREFIX=backups/
# Host default; in-Compose core uses http://floci:4566
S3_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
# Dev-only placeholder credentials for local Floci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
