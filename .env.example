NODE_ENV=development

# API
API_PORT=3000

# Worker
WORKER_SERVICE_PORT=3004
CORE_URL=http://localhost:3000
# Face detection backend: human (default, @vladmandic/human + tfjs) or scrfd (SCRFD det_10g.onnx)
# SCRFD weights live under STORAGE_DIR/models (pnpm --filter @photox/worker-service face-model)
FACE_DETECTOR=human
# Optional: override the SCRFD detector model file (default <STORAGE_DIR>/models/det_10g.onnx)
# FACE_DETECTOR_MODEL_PATH=/path/to/det_10g.onnx

# Web App (same-origin /api in dev)
VITE_API_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=photox
POSTGRES_PASSWORD=photox_dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=photox_dev

# Auth
AUTH_TOKEN_SECRET=change-me-to-at-least-32-characters-long-string
AUTH_ACCESS_TTL=30m
AUTH_REFRESH_TTL=1d
AUTH_CLOCK_TOLERANCE_SEC=60

# Local file storage (default for local dev)
STORAGE_DIR=./data/storage
